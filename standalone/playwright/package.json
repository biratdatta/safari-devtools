{
  "name": "safari-devtools-playwright",
  "private": true,
  "scripts": {
    "setup": "npm install && npx playwright install webkit chromium",
    "test:safari": "playwright test --project=\"Desktop Safari (WebKit)\" --project=\"iPhone (WebKit)\"",
    "test:chrome": "playwright test --project=\"Desktop Chrome\" --project=\"Android (Chrome)\"",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "real-safari": "node real-safari.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.0.0",
    "selenium-webdriver": "^4.27.0"
  }
}
